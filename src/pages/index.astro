---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { site } from '../data/site.js';
import { publications, ME } from '../data/publications.js';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date - a.data.date);
const latest = posts.slice(0, 8);
---
<Base title={site.name}>
  <section class="hero" id="bio">
    <div class="hero-top">
      <img class="portrait" src="/avatar.png" alt={site.name} width="92" height="92" />
      <div>
        <h1 class="name">{site.name}<span class="zh">{site.nameZh}</span></h1>
        <div class="role">
          {site.role}<br />
          School of Public Health · <a href={site.affiliationUrl}>The University of Hong Kong</a>
        </div>
      </div>
    </div>

    <div class="lede">
      <p>
        I am a bioinformatics PhD student at the School of Public Health, The University of Hong Kong,
        supervised by <strong>Prof. Leo Poon</strong>.
      </p>
      <p>
        My research uses viral genomic data to study how viruses evolve, how they move between hosts, and how
        they interact with the cells they infect — mostly influenza A virus and SARS-CoV-2.
      </p>
      <p>
        This site collects my publications and the notes I write along the way: analysis workflows, reading
        notes, and the occasional unrelated tutorial.
      </p>
    </div>

    <div class="contact">
      <span class="mail"><span>{site.email}</span><button class="copy" id="copy-mail" type="button">Copy</button></span>
      {site.links.map((l) => <a class="chip" href={l.url}>{l.label}</a>)}
      <a class="chip" href={site.cv}>CV (PDF)</a>
    </div>
  </section>

  <section id="background">
    <span class="eyebrow">Background</span>
    <div class="facts">
      <div>
        <h3>Education</h3>
        <ul class="stack">
          {site.education.map((e) => (
            <li>
              <span class="deg">{e.degree}</span>
              <span class="inst">{e.school} · {e.when}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3>Research interests</h3>
        <ul class="tags">{site.interests.map((i) => <li>{i}</li>)}</ul>
        <h3>Tools I work with</h3>
        <ul class="tags">{site.tools.map((t) => <li>{t}</li>)}</ul>
      </div>
    </div>
  </section>

  <section id="publications">
    <span class="eyebrow">Publications</span>
    <ol class="pubs">
      {publications.map((p) => (
        <li class="pub">
          <span class="year">{p.year}</span>
          <div class="pub-b">
            <h2 class="pub-t">{p.title}</h2>
            <p class="authors">
              {p.authors.map((a, i) => (
                <>
                  {i > 0 && ', '}
                  {a === ME ? <b>{a}</b> : a}
                </>
              ))}
            </p>
            <p class="venue"><em>{p.venue}</em>{p.detail && <> · {p.detail}</>} · {p.date}</p>
            <div class="pub-links">
              {p.links.map((l) => <a href={l.url}>{l.label}</a>)}
            </div>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section id="blog">
    <span class="eyebrow">Blog</span>
    <PostList posts={latest} />
    {posts.length > latest.length && <a class="more" href="/blog/">All {posts.length} posts →</a>}
  </section>

  <script is:inline>
    (function () {
      var btn = document.getElementById('copy-mail');
      if (!btn) return;
      var el = btn.previousElementSibling;
      function select() {
        try {
          var r = document.createRange();
          r.selectNodeContents(el);
          var s = getSelection();
          s.removeAllRanges();
          s.addRange(r);
          btn.textContent = 'Select + ⌘C';
          setTimeout(function () { btn.textContent = 'Copy'; }, 2400);
        } catch (e) {}
      }
      btn.addEventListener('click', function () {
        var done = function () {
          btn.textContent = 'Copied';
          setTimeout(function () { btn.textContent = 'Copy'; }, 1600);
        };
        try { navigator.clipboard.writeText(el.textContent.trim()).then(done, select); } catch (e) { select(); }
      });
    })();
  </script>
</Base>
